struct PowerManager
{{
	int GetAvailablePower()
	{
		return currentPower.second - currentPower.first;
	}
	
	int GetMaxPower()
	{
		int ret = currentPower.second - (iTempPowerLoss + iHacked);
		return ret > iTempPowerCap ? iTempPowerCap : ret;
	}
}};
