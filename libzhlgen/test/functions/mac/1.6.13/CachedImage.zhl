struct CachedImage
{{
	enum Centered
	{
	  CENTERED = 0x0,
	};

	CachedImage(const std::string& path, int x, int y)
	{
		constructor(path, x, y);
	}

	CachedImage(const std::string& path, Centered centered)
	{
		constructor(path, centered);
	}

	CachedImage()
	{

	}

	CachedImage(const CachedImage& source)
	{
		constructor(source);
	}
}};
