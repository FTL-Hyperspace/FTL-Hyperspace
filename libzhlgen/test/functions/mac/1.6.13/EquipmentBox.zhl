cleanup __amd64 void EquipmentBox::constructor(EquipmentBox *this, Point _position, int _slot);


struct EquipmentBox depends (AugmentBlueprint)
{{
	EquipmentBox()
	{

	}

	EquipmentBox(Point position, int slot)
	{
		this->constructor(position, slot);
	}

	bool IsEmpty()
	{
		return !item.pWeapon && !item.pDrone && (!item.augment || item.augment->name.empty()) && !item.pCrew;
	}
}};
