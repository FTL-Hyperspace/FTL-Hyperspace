struct Pointf {{
	Pointf() : x(0.f), y(0.f) {}
	Pointf(float _x, float _y) : x(_x), y(_y) {}
	Pointf(Point p) : x((float)p.x), y((float)p.y) {}

	Pointf operator+(const Pointf& other)
	{
		return Pointf(x + other.x, y + other.y);
	}

	Pointf operator-(const Pointf& other)
	{
		return Pointf(x - other.x, y - other.y);
	}

	// linux64 binds this overload; the Lua bindings are generated from its header
	Pointf operator-(Pointf *rhs)
	{
		return Pointf(x - rhs->x, y - rhs->y);
	}

	Pointf operator/(float amount)
	{
		return Pointf(x / amount, y / amount);
	}

	Pointf operator*(float amount)
	{
		return Pointf(x * amount, y * amount);
	}

	friend bool operator==(const Pointf &a, const Pointf &b) {return a.x==b.x && a.y==b.y;}
	friend bool operator!=(const Pointf &a, const Pointf &b) {return a.x!=b.x || a.y!=b.y;}

}};
