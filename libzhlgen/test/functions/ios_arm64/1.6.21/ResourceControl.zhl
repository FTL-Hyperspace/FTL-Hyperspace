offsetVariable ResourceControl* Global_ResourceControl_GlobalResources;


struct ResourceControl depends (freetype)
{{
	// Not separate functions in the iPad build; Hyperspace implements them
	// (src/game/Utilities/Resources.cpp), as the Mac ones work
	bool ImageExists(const std::string& name);
	void RenderImageString(const std::string &imageName, int x, int y, int rotation, GL_Color color, float alpha, bool mirror);

	enum ImageSwappingMode
	{
	  SWAP_NONE = 0x0,
	  SWAP_SHIP_SETS = 0x1,
	  SWAP_DYNAMIC_SHIPS = 0x2,
	};

	ResourceControl()
	{
		this->constructor();
	}
}};
