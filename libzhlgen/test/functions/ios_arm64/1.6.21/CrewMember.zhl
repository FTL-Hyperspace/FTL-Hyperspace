struct CrewMember depends (CrewAnimation, CrewBlueprint, ShipObject)
{{
	// Inlined everywhere in the iPad build; Hyperspace's own copies are in android/InlinedFunctions.cpp
	bool Sabotaging();
	bool AtGoal();
	Point GetFinalGoal();
	std::string GetLongName();
	// Inlined everywhere in the iPad build, so there's no game function to call
	void MasterSkill(int skill)
	{
		this->blueprint.skillLevel[skill].first = this->blueprint.skillLevel[skill].second;
	}
	// Inlined everywhere in the iPad build, so there's no game function to call
	void SetResisted(bool resisted)
	{
		this->bResisted = resisted;
	}
	CrewMember()
	{

	}

	CrewMember(CrewBlueprint& blueprint, int shipId, bool intruder, CrewAnimation* animation)
	{
		this->constructor(blueprint, shipId, intruder, animation);
	}

	ShipObject* GetShipObject()
	{
		return (ShipObject*)(this);
	}

	int GetPowerOwner();

	bool _HS_ValidTarget(int shipId);
	bool _HS_GetControllable();
	bool _HS_CanSuffocate();
	bool _HS_CanFight();
	bool _HS_CanRepair();
	bool _HS_CanSabotage();
	bool _HS_CanMan();
	bool _HS_CanTeleport();
	bool _HS_CanBurn();
	int _HS_GetMaxHealth();
	float _HS_GetMoveSpeedMultiplier();
	float _HS_GetRepairSpeed();
	float _HS_GetDamageMultiplier();
	bool _HS_ProvidesPower();
	float _HS_FireRepairMultiplier();
	bool _HS_IsTelepathic();
	float _HS_GetSuffocationModifier();
	bool _HS_IsAnaerobic();
	bool _HS_HasSpecialPower();
	std::pair<float, float> _HS_GetPowerCooldown();
	bool _HS_PowerReady();
	void _HS_ResetPower();
	void _HS_ActivatePower();

	inline Point GetGridPosition()
	{
		return Point((int)this->x, (int)this->y);
	}
}};
