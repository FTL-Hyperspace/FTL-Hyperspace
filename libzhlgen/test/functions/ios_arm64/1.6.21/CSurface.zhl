static cleanup __arm64 GL_Primitive* CSurface::_CreateImagePrimitive(GL_Texture *tex, float x, float y, float size_x, float size_y, float u0, float v0, float u1, float v1, GL_Color color, float rotate, bool background);


struct CSurface depends (GL_Primitive)
{{
	// FTL for iPad's GL_BlitPixelImage and _CreateImagePrimitive take one more argument than
	// the PC ones: true draws the image as part of the background, 176 further left (the
	// iPad's backgrounds are wider than its HUD). Hyperspace's calls are the PC ones.
	static bool GL_BlitPixelImage(GL_Texture* tex, float x, float y, float x2, float y2, float rotation, GL_Color color, bool mirror)
	{
		return GL_BlitPixelImage(tex, x, y, x2, y2, rotation, color, mirror, false);
	}

