struct FileHelper
{{
	// Not separate functions in the iPad build (inlined where it uses them); Hyperspace
	// implements them in overrides/FileHelper.cpp
	static std::string getUserFolder();
	static std::string getSaveFile();
	static bool fileExists(const std::string& fileName);
	static void renameFile(const std::string& fileName, const std::string& newName);
	static void deleteFile(const std::string& fileName);
	static int createBinaryFile(const std::string& fileName);
	static int readBinaryFile(const std::string& fileName);
	static char* readBuffer(int file, int len, bool nullTerminate);

	// TODO: Reimplement using using fstat()
    static int fileLength(int fd)
    {
        FILE* fp = fdopen(dup(fd), "r"); // Duplicate file descriptor&  then open the stream so that we can fclose correctly later on
        rewind(fp); // TODO: Not sure if we have to rewind before but could it hurt?
        fseek(fp, 0, SEEK_END);
        int lengthOfFile = ftell(fp);
        rewind(fp); // Rewind since the file index is shared and lets not screw with other people using the file descriptor that was opened by `open` in FTL's code
        fclose(fp);
        return lengthOfFile;
    }
}};
