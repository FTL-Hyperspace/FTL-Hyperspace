struct StarMap
{{
	// Inlined everywhere in the iPad build, so there's no game function to call
	void ReverseBossPath()
	{
		this->reversedPath = !this->reversedPath;
		for (size_t i = 0, j = this->boss_path.size(); i + 1 < j; i++, j--)
			std::swap(this->boss_path[i], this->boss_path[j - 1]);
		this->bossLoc = (int)this->boss_path.size() - 1 - this->bossLoc;
	}
	bool WillBeOvertaken(Location* loc);
}};
