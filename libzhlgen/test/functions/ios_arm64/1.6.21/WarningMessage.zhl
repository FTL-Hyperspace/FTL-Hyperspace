struct WarningMessage
{{
	// Inlined everywhere in the iPad build, so there's no game function to call
	void SetSound(const std::string &sound)
	{
		this->sound = sound;
	}
	WarningMessage()
	{
		this->constructor();
	}

	inline void Stop()
	{
		this->tracker.Stop(false);
	}
}};
