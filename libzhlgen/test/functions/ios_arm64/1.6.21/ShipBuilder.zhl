struct ShipBuilder
{{
	// Inlined everywhere in the iPad build, so there's no game function to call
	void ClearShipAchievements()
	{
		this->shipAchievements.clear();
		this->selectedAch = -1;
	}
    inline void Finish()
    {
        this->bDone = true;
    }
}};
