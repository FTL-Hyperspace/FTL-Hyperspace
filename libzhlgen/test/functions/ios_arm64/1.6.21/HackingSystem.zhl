// Continue from HackingDrone::OnLoop (hyper efficiency™)

struct HackingSystem
{{
	// Inlined everywhere in the iPad build, so there's no game function to call
	void BlowHackingDrone()
	{
		if (this->drone.deployed) this->drone.SpaceDrone::BlowUp(false);
	}
}};
