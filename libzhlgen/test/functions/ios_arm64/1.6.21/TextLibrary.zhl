struct TextLibrary depends (TextString)
{{
	std::string GetText(const std::string& name)
	{
		return TextLibrary::GetText(name, currentLanguage);
	}

	void SetLanguage(const std::string& language)
	{
		currentLanguage = language;
	}
}};
