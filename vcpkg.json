{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg/master/scripts/vcpkg.schema.json",
    "name": "hyperspace",
    "version": "0.1.0",
    "dependencies": [
        "boost-atomic",
        "boost-filesystem",
        "boost-conversion",
        "boost-algorithm",
        "boost-lexical-cast",
        "boost-format",
        "boost-crc",
        { "name": "discord-rpc", "platform": "!android" },
        { "name": "opengl", "platform": "!android" },
        "lua",
        {
            "name": "sdl3",
            "platform": "!android",
            "default-features": false,
            "features": [
                { "name": "x11", "platform": "linux" },
                { "name": "wayland", "platform": "linux" }
            ]
        },
        "minizip"
    ],
    "builtin-baseline": "4ff4b6bb22fad8afcc0e88ca6970c423bf3f7bfd",
    "overrides": [
        {
            "name": "lua",
            "version": "5.3.5",
            "port-version": 6
        },
        {
            "name": "minizip",
            "version": "1.2.11",
            "port-version": 10
        },
        {
            "name": "zlib",
            "version": "1.3.1"
        }
    ]
}
