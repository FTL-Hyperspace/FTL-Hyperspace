---
/** Chart of total GitHub downloads over time. Visibility is handled by .gh-collapsed in global.css. */
interface Props {
	/** Accessible description of the chart, read by screen readers. */
	label: string;
}

const { label } = Astro.props;
---

<div class="downloads-chart gh-collapsed not-content" data-label={label}>
	<div class="plot"></div>
</div>

<style>
	.downloads-chart {
		margin-top: 1.5rem;
	}

	.plot {
		position: relative;
		max-width: 48rem;
		margin-inline: auto;
	}

	/* The SVG is built by downloads-chart.ts, outside Astro's scoped styles. */
	.plot :global(svg) {
		display: block;
		width: 100%;
		overflow: visible;
		cursor: crosshair;
		outline-offset: 4px;
		/* Dragging a finger across reads values; vertical swipes still scroll. */
		touch-action: pan-y;
	}

	.plot :global(.grid) {
		stroke: var(--sl-color-gray-5);
		stroke-width: 1;
	}

	.plot :global(.tick) {
		fill: var(--sl-color-gray-3);
		font-size: 11px;
		font-variant-numeric: tabular-nums;
	}

	.plot :global(.area) {
		fill: hsla(var(--hs-violet), 0.18);
	}

	.plot :global(.line) {
		fill: none;
		stroke: var(--sl-color-accent);
		stroke-width: 2;
		stroke-linejoin: round;
	}

	.plot :global(.guide) {
		stroke: var(--sl-color-gray-4);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}

	.plot :global(.marker) {
		fill: hsl(var(--hs-amber));
		stroke: var(--hs-splash-bg);
		stroke-width: 2;
	}

	.plot :global(.tooltip) {
		position: absolute;
		pointer-events: none;
		padding: 0.375rem 0.625rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.375rem;
		background: var(--sl-color-gray-6);
		white-space: nowrap;
		text-align: start;
		line-height: 1.35;
		transform: translate(-50%, calc(-100% - 0.75rem));
	}

	.plot :global(.tooltip strong) {
		display: block;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}

	.plot :global(.tooltip span) {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
	}
</style>

<script>
	import { drawDownloadsChart } from './downloads-chart';
	import { loadedMetrics } from './status';

	const chart = document.querySelector<HTMLElement>('.downloads-chart')!;

	loadedMetrics.then((loaded) => {
		if (!loaded) return;
		// Draws once the chart has a width, and again whenever that width changes.
		drawDownloadsChart(chart.querySelector<HTMLElement>('.plot')!, loaded.metrics.releases, chart.dataset.label!);
	});
</script>
