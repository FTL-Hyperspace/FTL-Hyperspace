---
import { credits } from '~/data/credits';

const t = Astro.locals.t;
const sections = [
	{ key: 'credits.development', names: credits.development },
	{ key: 'credits.art', names: credits.art },
	{ key: 'credits.specialThanks', names: credits.specialThanks },
] as const;
---

<section class="credits">
	<h2>{t('credits.title')}</h2>
	{
		sections.map(({ key, names }) => (
			<div class="group">
				<p class="role">{t(key)}</p>
				<p class="names">{names.join(' · ')}</p>
			</div>
		))
	}
</section>

<style>
	.credits {
		margin-block: 4rem 2rem;
		text-align: center;
	}

	.credits h2 {
		font-size: var(--sl-text-xl);
		margin-bottom: 2.5rem;
		border: none;
	}

	.group + .group {
		margin-top: 2rem;
	}

	.role {
		font-size: var(--sl-text-xs);
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
		margin-bottom: 0.5rem;
	}

	/* Names wrap as one flowing line rather than a list — the separator does
	   the work, so a 10-name credit stays compact at any width. */
	.names {
		max-width: 42rem;
		margin-inline: auto;
		line-height: 1.8;
		color: var(--sl-color-white);
		text-wrap: balance;
	}
</style>
